#pragma once

#define ON true
#define OFF false

struct BuildInfo
{
    enum class ECompiler
    {
        AppleClang,
        Clang,
        GNU,
        MSVC,
        SunPro,
        Intel
    };

    enum class EOperatingSystem
    {
        Windows,
        Linux,
        Android,
        FreeBSD,
        Darwin // (Apple)
    };

    static constexpr const char*      CompilerName {"${CMAKE_CXX_COMPILER_ID}"};
    static constexpr const char*      SystemName   {"${CMAKE_SYSTEM_NAME}"};
    static constexpr ECompiler        CompilerID   {ECompiler::${CMAKE_CXX_COMPILER_ID}};
    static constexpr EOperatingSystem SystemID     {EOperatingSystem::${CMAKE_SYSTEM_NAME}};

    static constexpr const char*  BuildType      {"${CMAKE_BUILD_TYPE}"};
    static constexpr bool         HasDebugInfo   {${RUKEN_BUILD_HAS_DEBUG_INFO}};
    static constexpr bool         HeadlessBuild  {${RUKEN_HEADLESS_BUILD}};
    static constexpr bool         TraceBuild     {${RUKEN_TRACE_BUILD}};
    static constexpr bool         BreakOnError   {${RUKEN_BREAK_ON_ERROR}}; // The engine always breaks for fatal logs

    static const char* Version;
    static const char* Revision;
};

#cmakedefine RUKEN_HEADLESS_BUILD
#cmakedefine RUKEN_TRACE_BUILD
#cmakedefine RUKEN_BREAK_ON_ERROR
#cmakedefine RUKEN_BUILD_HAS_DEBUG_INFO

#cmakedefine01 RUKEN_TRACE_SHOW_WORKER_ZONES
#cmakedefine01 RUKEN_TRACE_SHOW_ALLOC_ZONES
#cmakedefine01 RUKEN_TRACE_SHOW_PROMISE_ZONES
#cmakedefine01 RUKEN_TRACE_SHOW_LOGGER_ZONES

#define RUKEN_COMPILER_${CMAKE_CXX_COMPILER_ID}
#define RUKEN_OS_${SYSTEM_NAME_TOUPPER}

#undef ON
#undef OFF